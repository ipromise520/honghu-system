/* 装维人员端 · 小程序全局样式（rpx 单位，750 设计稿） */
page {
  background: #f2f5fa;
  color: #0f172a;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.app { max-width: 750rpx; margin: 0 auto; min-height: 100%; overflow-x: hidden; padding-bottom: 40rpx; }

/* 头部 */
.hero {
  position: relative;
  padding: 32rpx 32rpx 40rpx;
  border-radius: 0 0 44rpx 44rpx;
  background: linear-gradient(158deg, #1e3a8a 0%, #2b6cb0 64%, #3084c4 100%);
  color: #fff;
  overflow: hidden;
}
.hero-top { display: flex; align-items: center; gap: 24rpx; }
.avatar {
  width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 30rpx;
  background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.3);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700;
}
.who { min-width: 0; flex: 1; }
.who-name { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; display: flex; align-items: center; gap: 12rpx; }
.who-tag { font-size: 20rpx; font-weight: 600; padding: 2rpx 12rpx; border-radius: 40rpx; background: rgba(255,255,255,.22); }
.who-meta { font-size: 24rpx; opacity: .82; margin-top: 6rpx; }
.seg {
  margin-top: 24rpx; display: flex; gap: 8rpx; padding: 6rpx;
  border-radius: 22rpx; background: rgba(255,255,255,.16);
}
.seg-btn {
  flex: 1; border: 0; background: transparent; color: rgba(255,255,255,.82);
  font-size: 26rpx; padding: 14rpx 0; border-radius: 18rpx; line-height: 1.2;
}
.seg-btn.on { background: #fff; color: #1e3a8a; font-weight: 700; }
.hero-month {
  margin-top: 28rpx; display: flex; align-items: center; justify-content: space-between;
  font-size: 23rpx; opacity: .85;
}
.refresh { display: flex; align-items: center; }

/* 分组 */
.grp { margin-top: 40rpx; }
.grp-h { display: flex; align-items: baseline; gap: 16rpx; padding: 0 32rpx 18rpx; }
.grp-t { font-size: 29rpx; font-weight: 700; }
.grp-line { flex: 1; height: 1rpx; background: linear-gradient(90deg, #e8edf5, transparent); }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 0 28rpx; }

/* 卡片 */
.card {
  position: relative; background: #fff; border-radius: 28rpx; padding: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(15,23,42,.04), 0 12rpx 36rpx -20rpx rgba(15,23,42,.18);
  overflow: hidden; animation: rise .44s cubic-bezier(.22,1,.36,1) both;
}
@keyframes rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
.card::before {
  content: ""; position: absolute; left: 0; top: 40rpx; bottom: 40rpx; width: 6rpx;
  border-radius: 0 6rpx 6rpx 0; background: var(--c, #2563eb);
}
.card-h { display: flex; align-items: center; gap: 10rpx; color: #475569; font-size: 24rpx; }
.card-v { margin-top: 14rpx; display: flex; align-items: baseline; gap: 4rpx; }
.v { font-size: 52rpx; font-weight: 700; line-height: 1.05; letter-spacing: -1rpx; }
.u { font-size: 22rpx; color: #94a3b8; }
.card-s { margin-top: 10rpx; font-size: 22rpx; color: #94a3b8; min-height: 30rpx; }
.gbadge { font-size: 20rpx; padding: 0 10rpx; border-radius: 10rpx; line-height: 30rpx; background: #eef4ff; color: #2c5282; font-weight: 600; }
.badge-dot {
  margin-left: auto; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 18rpx;
  background: #dc2626; color: #fff; font-size: 20rpx; font-weight: 700;
  display: inline-flex; align-items: center; justify-content: center;
}
.card.is-none { background: #fbfcfe; border: 1rpx dashed #e2e8f0; }

/* 行 / 明细 */
.row { background: #fff; border-radius: 24rpx; padding: 22rpx 24rpx; margin-bottom: 18rpx; box-shadow: 0 2rpx 4rpx rgba(15,23,42,.04); animation: rise .36s cubic-bezier(.22,1,.36,1) both; }
.row-h { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row-no { font-family: ui-monospace, Menlo, monospace; font-size: 24rpx; font-weight: 600; word-break: break-all; }
.row-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 12rpx; background: #f1f5f9; color: #475569; white-space: nowrap; }
.row-tag.danger { background: #fef2f2; color: #b91c1c; }
.row-tag.warn { background: #fff7ed; color: #b45309; }
.row-tag.ok { background: #f0fdf4; color: #15803d; }
.row-kv { display: flex; flex-wrap: wrap; gap: 8rpx 28rpx; margin-top: 12rpx; font-size: 24rpx; color: #475569; }
.row-kv .k { color: #94a3b8; }

.empty { text-align: center; padding: 100rpx 40rpx; color: #94a3b8; }
.empty .t { font-size: 28rpx; color: #475569; margin-top: 16rpx; }
.empty .p { font-size: 24rpx; margin-top: 10rpx; line-height: 1.7; }

.doc { background: #fff; border-radius: 28rpx; padding: 32rpx 30rpx; box-shadow: 0 2rpx 4rpx rgba(15,23,42,.04); }
.doc h2 { font-size: 33rpx; margin: 0 0 16rpx; line-height: 1.45; }
.doc .meta { font-size: 22rpx; color: #94a3b8; display: flex; gap: 20rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.doc .content { font-size: 28rpx; color: #1e293b; line-height: 1.85; white-space: pre-wrap; word-break: break-word; }
.note { font-size: 23rpx; color: #94a3b8; padding: 4rpx 4rpx 20rpx; line-height: 1.7; }
.sign-bar { margin-top: 30rpx; }
.sign-done { text-align: center; font-size: 25rpx; color: #15803d; background: #f0fdf4; border: 1rpx solid #dcfce7; border-radius: 24rpx; padding: 22rpx; }

.skeleton { padding: 36rpx 28rpx; }
.sk { height: 148rpx; border-radius: 28rpx; margin-bottom: 20rpx; background: linear-gradient(100deg,#eef2f7 30%,#f7fafc 50%,#eef2f7 70%); background-size: 220% 100%; animation: shine 1.2s linear infinite; }
@keyframes shine { to { background-position: -220% 0; } }

/* 登录 */
.login { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 52rpx 44rpx; background: linear-gradient(170deg,#1e3a8a 0%,#2b6cb0 52%,#f2f5fa 52%,#f2f5fa 100%); }
.login-card { background: #fff; border-radius: 36rpx; padding: 48rpx 40rpx; box-shadow: 0 24rpx 80rpx -32rpx rgba(15,23,42,.38); }
.login-brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 8rpx; }
.login-brand .dot { width: 68rpx; height: 68rpx; border-radius: 20rpx; background: linear-gradient(140deg,#1e3a8a,#2b6cb0); }
.login h1 { font-size: 36rpx; margin: 0; letter-spacing: 1rpx; }
.login .sub { font-size: 24rpx; color: #94a3b8; margin: 20rpx 0 40rpx; }
.field { margin-bottom: 26rpx; }
.field label { display: block; font-size: 24rpx; color: #475569; margin-bottom: 12rpx; font-weight: 600; }
.field input { width: 100%; height: 92rpx; border-radius: 22rpx; border: 1rpx solid #dfe6f0; padding: 0 26rpx; font-size: 30rpx; background: #fbfcfe; }
.tip { text-align: center; font-size: 23rpx; color: rgba(255,255,255,.85); margin-top: 32rpx; line-height: 1.7; }
.tip code { background: rgba(255,255,255,.18); padding: 2rpx 10rpx; border-radius: 10rpx; font-family: ui-monospace, monospace; }
.err { color: #dc2626; font-size: 25rpx; margin: 4rpx 0 20rpx; }

/* 搜索框（知识库） */
.search-box { position: relative; margin-bottom: 20rpx; }
.search-box input { width: 100%; height: 88rpx; border-radius: 24rpx; border: 1rpx solid #dfe6f0; padding: 0 80rpx; font-size: 28rpx; background: #fbfcfe; }
.search-ico { position: absolute; left: 26rpx; top: 26rpx; opacity: .4; font-size: 32rpx; }

/* 明细 / 通用页壳 */
.sheet { display: flex; flex-direction: column; min-height: 100vh; background: #f2f5fa; }
.bar-top {
  display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx;
  background: rgba(255,255,255,.92); border-bottom: 1rpx solid #e8edf5;
}
.bar-title { font-size: 31rpx; font-weight: 700; flex: 1; text-align: center; }
.icon-btn {
  width: 68rpx; height: 68rpx; border-radius: 20rpx; border: 1rpx solid #e8edf5; background: #fff;
  display: flex; align-items: center; justify-content: center; color: #475569; font-size: 44rpx; line-height: 1;
}
.tabs { display: flex; gap: 12rpx; padding: 20rpx 28rpx 4rpx; }
.tabs-btn { flex: 1; border: 1rpx solid #e8edf5; background: #fff; color: #475569; font-size: 26rpx; padding: 16rpx 0; border-radius: 20rpx; }
.tabs-btn.on { background: #1e3a8a; border-color: #1e3a8a; color: #fff; font-weight: 700; }
.body { flex: 1; overflow-y: auto; padding: 20rpx 28rpx 48rpx; }

/* 我的任务：操作按钮 */
.task { border-left: 6rpx solid #2563eb; }
.task-ops {
  display: flex; justify-content: flex-end; gap: 16rpx;
  margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx dashed #e8edf5;
}
.btn-sm {
  height: 58rpx; line-height: 58rpx; padding: 0 28rpx; border-radius: 16rpx;
  border: 1rpx solid #e2e8f0; background: #fff; color: #475569;
  font-size: 25rpx; font-weight: 600;
}
.btn-sm.primary {
  background: linear-gradient(135deg, #2563eb, #1d4ed8); border-color: transparent;
  color: #fff; box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, .28);
}
