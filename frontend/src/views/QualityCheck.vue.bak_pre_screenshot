.reason-head { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
.reason-name { color: #303133; }
.reason-cnt { color: #f56c6c; font-weight: 600; }
.reason-bar { height: 8px; background: #f0f2f5; border-radius: 4px; overflow: hidden; }
.reason-inner { height: 100%; background: linear-gradient(90deg, #f89898, #f56c6c); border-radius: 4px; }
