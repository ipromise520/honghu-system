.stat-value .unit { font-size: 12px; font-weight: 400; color: #909399; margin-left: 3px; }
.stat-sub { font-size: 12px; color: #909399; }
.block-title { font-weight: 600; font-size: 14px; margin: 6px 0 8px; }
.gp-red { color: #f56c6c; font-weight: 600; }
.muted { color: #c0c4cc; }
.tip-sm { color: #909399; font-size: 12px; font-weight: 400; margin-left: 8px; }
.wide-table :deep(.el-table__header th) { background: #f5f7fa; }
.wide-table :deep(.el-table__row) { cursor: pointer; }
